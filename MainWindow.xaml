<Window x:Class="SocialMediaDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Social Media Downloader"
        Height="860"
        Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Social Media Downloader"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#222"
                   Margin="0,0,0,20"/>

        <!-- URL CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="Social Media URL"
                   FontWeight="SemiBold"
                   Foreground="#444"
                   Margin="0,0,0,8"/>

                <TextBox Text="{Binding Url}"
                 Height="45"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 BorderThickness="0"
                 Background="#F2F2F2"
                 Padding="10"/>

                <TextBlock Text="File Name"
                 FontWeight="SemiBold"
                 Margin="0,10,0,5"
                 Foreground="#444"/>

                <TextBox Text="{Binding FileName}"
                 Height="45"
                 FontSize="14"
                 Padding="10"
                 Background="#F2F2F2"
                 BorderThickness="0"/>

                <Button Content="Check"
                Height="38"
                Margin="0,10,0,0"
                Command="{Binding CheckCommand}"
                Background="#4F46E5"
                Foreground="White"
                BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- MEDIA INFO -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#111"/>

                <TextBlock Text="{Binding Platform}"
                           Margin="0,5,0,0"
                           Foreground="#666"/>

            </StackPanel>
        </Border>

        <!-- FORMAT + DESTINATION -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FORMATS -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Available Formats"
                               FontWeight="SemiBold"
                               Foreground="#444"
                               Margin="0,0,0,8"/>

                    <ComboBox ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}"
                              DisplayMemberPath="Label"
                              Height="38"
                              Background="#F2F2F2"
                              BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- DESTINATION -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="Download Destination"
                   FontWeight="SemiBold"
                   Foreground="#444"
                   Margin="0,0,0,8"/>

                    <TextBox Text="{Binding DestinationPath}"
                 Height="45"
                 BorderThickness="0"
                 Background="#F2F2F2"
                 Padding="10"/>

                    <Button Content="Browse"
                Height="38"
                Margin="0,10,0,0"
                Command="{Binding BrowseCommand}"
                Background="#10B981"
                Foreground="White"
                BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DOWNLOAD AREA -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,15,0,0">

            <StackPanel>

                <ProgressBar Height="18"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             Background="#E5E7EB"
                             Foreground="#4F46E5"/>

                <TextBlock Text="{Binding Status}"
                           Margin="0,8,0,0"
                           Foreground="#666"/>

                <Button Content="Download"
                        Height="42"
                        Margin="0,15,0,0"
                        Command="{Binding DownloadCommand}"
                        Background="#6366F1"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>

        </Border>

    </Grid>
</Window>